# GrowthOps OS runtime configuration. Copy to .env and fill in. Never commit .env.
# `python -m growthops.ops check-config` lists anything unsafe for production.

GROWTHOPS_ENV=production            # development | production (production refuses unsafe defaults)
GROWTHOPS_DATA_MODE=live            # live | synthetic; production also requires provider-backed dataset_origin evidence
GROWTHOPS_DATABASE=/data/growthops.db
GROWTHOPS_LOG_LEVEL=INFO
GROWTHOPS_LOG_FORMAT=json

# Security: generate with `python -c "import secrets; print(secrets.token_urlsafe(48))"`
GROWTHOPS_WEBHOOK_SECRET=           # shared with the payment provider bridge; 32+ characters
GROWTHOPS_STRIPE_TEST_WEBHOOK_SECRET= # optional Stripe CLI/Dashboard test endpoint secret; whsec_..., development only
GROWTHOPS_API_KEYS=                 # comma-separated read keys (24+ characters each); rotate by adding then removing
GROWTHOPS_OPS_TOKEN=                # operator token for replay and person-level reads in production
GROWTHOPS_WEBHOOK_TOLERANCE_SECONDS=300
GROWTHOPS_CORS_ORIGINS=             # optional, comma-separated browser origins

# Provider adapters (simulated by default)
GROWTHOPS_CRM_ADAPTER=simulated     # simulated | hubspot
HUBSPOT_ACCESS_TOKEN=               # private-app or service key; from a secret manager, never pasted anywhere else
GROWTHOPS_HUBSPOT_PORTAL_ID=        # the one HubSpot portal this deployment may touch (required in production)
GROWTHOPS_HUBSPOT_SYNC=off          # on: the worker pulls, reconciles, plans and applies approved change sets
GROWTHOPS_HUBSPOT_SYNC_MINUTES=15
GROWTHOPS_HUBSPOT_DAILY_FLOOR=0     # stop before HubSpot's daily allowance falls below this (0 = off)
GROWTHOPS_PII_HASH_KEY=             # 32+ characters; contact data from HubSpot is landed as a keyed hash
GROWTHOPS_HUBSPOT_APP_SECRET=       # HubSpot app client secret; enables POST /v2/webhooks/hubspot
GROWTHOPS_PUBLIC_BASE_URL=          # https URL HubSpot calls; needed to check webhook signatures behind a proxy
GROWTHOPS_ACCESS_ADAPTER=simulated  # simulated | webhook
GROWTHOPS_ACCESS_WEBHOOK_URL=
GROWTHOPS_ACCESS_WEBHOOK_SECRET=     # independent 32+ character bridge signing secret
GROWTHOPS_MESSAGING_ADAPTER=simulated
GROWTHOPS_MESSAGING_WEBHOOK_URL=
GROWTHOPS_MESSAGING_WEBHOOK_SECRET=  # independent 32+ character bridge signing secret
GROWTHOPS_ADAPTER_TIMEOUT_SECONDS=10

# Alerts and scheduling (worker)
GROWTHOPS_ALERT_WEBHOOK_URL=        # Slack-compatible incoming webhook; empty = log only (dry run)
GROWTHOPS_ALERT_MIN_PRIORITY=45
GROWTHOPS_WORKER_POLL_SECONDS=30
GROWTHOPS_DAILY_UPDATE_TIME_UTC=14:00
GROWTHOPS_FRESHNESS_SLA_HOURS=36

# Ask your data (keyless, local)
GROWTHOPS_RETRIEVAL_MODE=auto       # auto | hybrid | keyword

# Dashboard
GROWTHOPS_DASHBOARD_PASSWORD=       # required (16+ characters) with a configured DB; use SSO before exposing real data
