table mart_paid_efficiency_daily
	lineageTag: 0c718239-2b95-598d-a80f-4172baaa8bf1

	column day
		dataType: dateTime
		lineageTag: ec195778-fac9-505c-84d8-023ad4dfa926
		summarizeBy: none
		sourceColumn: day

