		lineageTag: 4a344e0d-d06a-5f68-8a84-d4670bf7d237
		summarizeBy: none
		sourceColumn: platform

	column spend_cents
		dataType: int64
		lineageTag: 822f9efa-fe3c-5dcd-a59c-03eec0260c30
		summarizeBy: none
		sourceColumn: spend_cents

	column impressions
		dataType: int64
		lineageTag: 9c104b8d-7900-5f5a-b32b-28f80011ba9a
		summarizeBy: none
		sourceColumn: impressions

	column clicks
		dataType: int64
		lineageTag: 7311919d-d00c-56e2-9d72-08eb21571a8e
		summarizeBy: none
		sourceColumn: clicks

	column leads
		dataType: int64
		lineageTag: 1e866d82-a00a-53d1-8c1f-580867a08d69
		summarizeBy: none
		sourceColumn: leads

	column mqls
		dataType: int64
		lineageTag: b7a77c26-5e8e-5a35-87ee-558ff0f0de92
		summarizeBy: none
		sourceColumn: mqls

	column calls_booked
		dataType: int64
		lineageTag: e3e3a6f1-8e4b-5ca4-8303-60c0654a2296
		summarizeBy: none
		sourceColumn: calls_booked

	column closed_won_deals
		dataType: int64
		lineageTag: acdd25fa-96d8-5cdd-a744-f3201726bfe2
		summarizeBy: none
		sourceColumn: closed_won_deals

	/// Paid media spend in the filter context, in dollars.
	measure 'Paid spend USD' = DIVIDE(SUM('mart_paid_efficiency_daily'[spend_cents]), 100)
		formatString: "$"#,0
		displayFolder: Paid efficiency
		lineageTag: 8da92ad0-ad98-5d73-86b6-3dec14da4c96

	/// Leads created by paid campaigns (activity basis).
	measure 'Paid leads' = SUM('mart_paid_efficiency_daily'[leads])
		formatString: #,0
		displayFolder: Paid efficiency
		lineageTag: 4f6d87e2-3084-52a0-8267-60814fcfd584

	/// Cost per lead: paid spend / paid leads in the same window.
	measure 'CPL USD' = DIVIDE([Paid spend USD], [Paid leads])
		formatString: "$"#,0.00
		displayFolder: Paid efficiency
		lineageTag: f5db4883-5c4d-502c-8c82-dc22b2ccbb56

	/// Paid spend / MQLs reached in the window by paid-created leads.
	measure 'Cost per MQL USD' = DIVIDE([Paid spend USD], SUM('mart_paid_efficiency_daily'[mqls]))
		formatString: "$"#,0.00
		displayFolder: Paid efficiency
		lineageTag: 73e805dc-87a4-57b6-a666-82cf2d0c9912

	/// Paid spend / discovery calls booked in the window by paid-created leads (CPDM).
	measure 'Cost per booked call USD' = DIVIDE([Paid spend USD], SUM('mart_paid_efficiency_daily'[calls_booked]))
		formatString: "$"#,0.00
		displayFolder: Paid efficiency
		lineageTag: 2208a2d1-9a93-537e-8f8e-8190d56a9ac7

	/// Cost per thousand impressions.
	measure 'CPM USD' = DIVIDE([Paid spend USD] * 1000, SUM('mart_paid_efficiency_daily'[impressions]))
		formatString: "$"#,0.00
		displayFolder: Paid efficiency
		lineageTag: 887ca634-6de9-542a-aec2-611adc49fa14

	/// Ad clicks / impressions.
	measure 'CTR' = DIVIDE(SUM('mart_paid_efficiency_daily'[clicks]), SUM('mart_paid_efficiency_daily'[impressions]))
		formatString: 0.00%
		displayFolder: Paid efficiency
		lineageTag: f1e62e33-8c2a-5f79-94d5-a91dcda98554

	/// Paid spend / ad clicks.
	measure 'CPC USD' = DIVIDE([Paid spend USD], SUM('mart_paid_efficiency_daily'[clicks]))
		formatString: "$"#,0.00
		displayFolder: Paid efficiency
		lineageTag: 4ad2cad5-b708-5ef6-994e-16c458881ffb

