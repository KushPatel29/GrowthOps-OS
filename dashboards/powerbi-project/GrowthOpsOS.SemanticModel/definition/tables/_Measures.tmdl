table _Measures
	lineageTag: 4df5ce8c-4aa6-5e59-ad08-eb1d6165148c

	/// The last complete day of data. Every 'last 28 days' figure ends here.
	measure 'As-of date' = CALCULATE(MAX(dim_date[date]), REMOVEFILTERS(dim_date))
		formatString: d mmm yyyy
		lineageTag: 69236b32-c527-5425-8bd2-991338300e7e
		displayFolder: 00 Calendar

	/// Days in the current date filter.
	measure 'Days in view' = COUNTROWS(dim_date)
		formatString: #,0
		lineageTag: 86622a62-2a30-5ef0-99c9-d661b39c002e
		displayFolder: 00 Calendar

	/// Payments received minus refunds, on the day each happened (event date).
	measure 'Net cash' = DIVIDE(SUM(mart_growth_daily[net_cash_cents]), 100)
		formatString: \$#,0
		lineageTag: 2791ae87-ecee-5edd-bd5b-e8ff9784ed83
		displayFolder: 01 Cash

	/// Payments received, on the payment date.
	measure 'Gross collected' = DIVIDE(SUM(mart_growth_daily[gross_collected_cents]), 100)
		formatString: \$#,0
		lineageTag: 7c865eb5-5ca3-5eda-91dd-56e4af0d15fd
		displayFolder: 01 Cash

	/// Money returned, on the refund date.
	measure 'Refunds' = DIVIDE(SUM(mart_growth_daily[refunds_cents]), 100)
		formatString: \$#,0
		lineageTag: a8dc5850-8489-51f2-86c6-21a18c316825
		displayFolder: 01 Cash

	/// Closed-won deal value on the close date, as the CRM records it.
	measure 'CRM booked' = DIVIDE(SUM(mart_growth_daily[booked_cents]), 100)
		formatString: \$#,0
		lineageTag: ebf70195-35c1-5ef8-bf61-bb373f5fd030
		displayFolder: 01 Cash

	/// Paid media spend on Meta, Google and LinkedIn, on the spend date.
	measure 'Ad spend' = DIVIDE(SUM(mart_growth_daily[spend_cents]), 100)
		formatString: \$#,0
		lineageTag: f7d5e650-0c6d-5fcc-9301-a93bd5474d8d
		displayFolder: 01 Cash

	/// Contacts created, every channel.
	measure 'Leads' = SUM(mart_growth_daily[leads])
		formatString: #,0
		lineageTag: 05d1f5d7-7072-5d50-8cca-7da4cce81982
		displayFolder: 01 Cash

	/// Contacts reaching marketing-qualified, on the day they qualified.
	measure 'MQLs' = SUM(mart_growth_daily[mqls])
		formatString: #,0
		lineageTag: 1b4a959d-3e42-5574-88af-45acd949d612
		displayFolder: 01 Cash

	/// Discovery calls booked, on the booking day.
	measure 'Calls booked' = SUM(mart_growth_daily[calls_booked])
		formatString: #,0
		lineageTag: 89af7259-48e2-560b-af10-6158b00b1a08
		displayFolder: 01 Cash

	/// Deals closed-won, on the close day.
	measure 'Deals won' = SUM(mart_growth_daily[closed_won_deals])
		formatString: #,0
		lineageTag: 7129475e-e841-533f-a331-15de02ccdef7
		displayFolder: 01 Cash

	/// MQLs / leads in the same window (event basis): a lagging read of lead quality.
	measure 'MQL rate' = DIVIDE([MQLs], [Leads])
		formatString: 0.0%
		lineageTag: b25c67fb-9445-53cc-a245-00d9154bfb21
		displayFolder: 01 Cash

	/// Ad spend / deals won in the same window. Blended: organic deals are in the denominator.
	measure 'Spend per deal won' = DIVIDE([Ad spend], [Deals won])
		formatString: \$#,0
		lineageTag: 57c3ff33-22e8-55e9-a683-8777fde8a3e9
		displayFolder: 01 Cash

	/// Spend by paid campaign and day.
	measure 'Paid spend' = DIVIDE(SUM(mart_paid_efficiency_daily[spend_cents]), 100)
		formatString: \$#,0
		lineageTag: 9926bf59-1b1e-5192-beb4-c0c22b5aea79
		displayFolder: 02 Paid media

	/// Ad impressions.
	measure 'Impressions' = SUM(mart_paid_efficiency_daily[impressions])
		formatString: #,0
		lineageTag: 8fc061a0-123f-5358-81f4-4a54083770af
		displayFolder: 02 Paid media

	/// Ad clicks.
	measure 'Ad clicks' = SUM(mart_paid_efficiency_daily[clicks])
		formatString: #,0
		lineageTag: bfacb84e-a138-506e-96a9-b324589554ee
		displayFolder: 02 Paid media

	/// Leads whose creating touch was a paid campaign, on the creation day.
	measure 'Paid leads' = SUM(mart_paid_efficiency_daily[leads])
		formatString: #,0
		lineageTag: 34289031-031c-53b2-998b-f5d0f936c0dc
		displayFolder: 02 Paid media

	/// MQLs reached in the window by leads a paid campaign created.
	measure 'Paid MQLs' = SUM(mart_paid_efficiency_daily[mqls])
		formatString: #,0
		lineageTag: 75072e50-f8b5-5aa1-ae0b-8e9c6e6570e4
		displayFolder: 02 Paid media

	/// Discovery calls booked in the window by paid-created leads.
	measure 'Paid calls booked' = SUM(mart_paid_efficiency_daily[calls_booked])
		formatString: #,0
		lineageTag: 850fd5f9-d1c5-5216-b530-cf70899398a2
		displayFolder: 02 Paid media

	/// Deals won in the window by paid-created leads.
	measure 'Paid deals won' = SUM(mart_paid_efficiency_daily[closed_won_deals])
		formatString: #,0
		lineageTag: 83326712-4d52-55e2-849b-8ee92c78ab0a
		displayFolder: 02 Paid media

	/// Cost per thousand impressions.
	measure 'CPM' = DIVIDE([Paid spend] * 1000, [Impressions])
		formatString: \$#,0.00
		lineageTag: 31756522-180c-59ca-b169-15e0f6db6960
		displayFolder: 02 Paid media

	/// Ad clicks / impressions.
	measure 'CTR' = DIVIDE([Ad clicks], [Impressions])
		formatString: 0.00%
		lineageTag: 9695652d-8512-56e3-99b4-7fe500c7244f
		displayFolder: 02 Paid media

	/// Paid spend / ad clicks.
	measure 'CPC' = DIVIDE([Paid spend], [Ad clicks])
		formatString: \$#,0.00
		lineageTag: 61f76487-1ba7-512b-9c5d-d5ac17ad8dae
		displayFolder: 02 Paid media

	/// Paid spend / paid leads in the same window (CPL).
	measure 'Cost per lead' = DIVIDE([Paid spend], [Paid leads])
		formatString: \$#,0.00
		lineageTag: 99fc70c4-2e81-52eb-b145-88700234d561
		displayFolder: 02 Paid media

	/// Paid spend / MQLs from paid-created leads in the same window.
	measure 'Cost per MQL' = DIVIDE([Paid spend], [Paid MQLs])
		formatString: \$#,0.00
		lineageTag: 25c4716c-4ac1-55d7-bb0f-2e724c5a65a7
		displayFolder: 02 Paid media

	/// Paid spend / discovery calls booked by paid-created leads (CPDM).
	measure 'Cost per booked call' = DIVIDE([Paid spend], [Paid calls booked])
		formatString: \$#,0.00
		lineageTag: 3a76bba9-33d2-5506-85d7-7f5fe1499a74
		displayFolder: 02 Paid media

	/// Paid MQLs / paid leads in the same window: lead quality by campaign.
	measure 'Paid MQL rate' = DIVIDE([Paid MQLs], [Paid leads])
		formatString: 0.0%
		lineageTag: 9d3baaff-694d-5a4d-9b6d-b3770f53c35a
		displayFolder: 02 Paid media

	/// Paid spend / deals won by paid-created leads.
	measure 'Cost per deal won' = DIVIDE([Paid spend], [Paid deals won])
		formatString: \$#,0
		lineageTag: 52815581-6fdc-5154-b368-f6b45120ae01
		displayFolder: 02 Paid media

	/// Net cash credited to the campaign whose touch created the lead, on the payment date. Sums to net cash.
	measure 'Attributed net cash' = DIVIDE(SUM(fact_cash_attribution[net_cash_cents]), 100)
		formatString: \$#,0
		lineageTag: 89e1a6e1-485d-5930-bab5-83e8947d70b3
		displayFolder: 03 Attribution

	/// Payments credited.
	measure 'Attributed payments' = COUNTROWS(fact_cash_attribution)
		formatString: #,0
		lineageTag: 50d8f865-9659-5dea-a649-43cbcb6e8003
		displayFolder: 03 Attribution

	/// Net cash credited to paid campaigns.
	measure 'Paid attributed net cash' = CALCULATE([Attributed net cash], dim_campaign[is_paid] = TRUE())
		formatString: \$#,0
		lineageTag: 8b6bc94e-b21a-5182-a9e0-dcad476b6893
		displayFolder: 03 Attribution

	/// Net cash credited to paid campaigns / paid spend. Descriptive, not incremental: it credits the creating touch.
	measure 'Cash ROAS' = DIVIDE([Paid attributed net cash], [Paid spend])
		formatString: 0.00"x"
		lineageTag: 6d62e23f-0bbb-5304-9b37-f8c7f2c46f31
		displayFolder: 03 Attribution

	/// Net cash from buyers with no lead-creation touch before paying.
	measure 'Unattributed net cash' = CALCULATE([Attributed net cash], dim_campaign[campaign_id] = "(unattributed)")
		formatString: \$#,0
		lineageTag: 6e5a9edd-2d36-576c-a137-c3446dfbb574
		displayFolder: 03 Attribution

	/// Share of net cash no campaign can claim.
	measure 'Unattributed share' = DIVIDE([Unattributed net cash], [Attributed net cash])
		formatString: 0.0%
		lineageTag: ffb54eb0-db6f-573a-b23a-565bed046fb5
		displayFolder: 03 Attribution

	/// All closed-won deal value in the CRM.
	measure 'Booked (CRM, all time)' = DIVIDE(SUM(mart_revenue[booked_cents]), 100)
		formatString: \$#,0
		lineageTag: 92b11bf7-8a07-5bcf-a7c9-8e0b15c7bc4b
		displayFolder: 04 Revenue truth

	/// All payments received.
	measure 'Gross collected (all time)' = DIVIDE(SUM(mart_revenue[gross_collected_cents]), 100)
		formatString: \$#,0
		lineageTag: 71d425e9-8ba7-53e5-95a5-861313fd5bc7
		displayFolder: 04 Revenue truth

	/// All refunds.
	measure 'Refunds (all time)' = DIVIDE(SUM(mart_revenue[refunds_cents]), 100)
		formatString: \$#,0
		lineageTag: 4d08fc9c-cf12-5133-87e5-c02bb9b661b5
		displayFolder: 04 Revenue truth

	/// All payments minus all refunds: the number the bank agrees with.
	measure 'Net collected (all time)' = DIVIDE(SUM(mart_revenue[net_collected_cents]), 100)
		formatString: \$#,0
		lineageTag: c4bca579-2521-5ed7-b103-8346d5136dde
		displayFolder: 04 Revenue truth

	/// Refunds / gross collected.
	measure 'Refund rate' = DIVIDE([Refunds (all time)], [Gross collected (all time)])
		formatString: 0.0%
		lineageTag: ee34e605-a5a5-5e6c-a647-a40dc3d52744
		displayFolder: 04 Revenue truth

	/// How far CRM bookings run ahead of the cash that arrived.
	measure 'CRM overstatement' = [Booked (CRM, all time)] - [Net collected (all time)]
		formatString: \$#,0
		lineageTag: 5c24f1e4-3d71-5992-bcaa-184e7c8e4ac5
		displayFolder: 04 Revenue truth

	/// Each step between CRM bookings and net cash. The chart adds them, so its total is the gap between the two.
	measure 'Bridge movement' = SUMX(FILTER(mart_revenue_bridge, mart_revenue_bridge[kind] = "delta"), mart_revenue_bridge[cents]) / 100
		formatString: \$#,0
		lineageTag: 7b9407c6-f07c-5b89-a60f-db26435e6df2
		displayFolder: 04 Revenue truth

	/// The bridge value at each step, totals included.
	measure 'Bridge amount' = DIVIDE(SUM(mart_revenue_bridge[cents]), 100)
		formatString: \$#,0
		lineageTag: 7f83454f-4e1b-52ce-815a-a0eabf9c66a9
		displayFolder: 04 Revenue truth

	/// Conversion value the ad platforms claim for themselves.
	measure 'Platform-reported value' = DIVIDE(SUM(mart_platform_comparison[reported_value_cents]), 100)
		formatString: \$#,0
		lineageTag: 28f9dc0a-d6f7-5976-9eca-71c99f0c341a
		displayFolder: 04 Revenue truth

	/// Value at explicit deal qualification, across qualified deals. Snapshot by campaign; USD.
	measure 'Qualified pipeline created' = DIVIDE(SUM(mart_qualified_pipeline[created_minor]), 100)
		formatString: \$#,0
		lineageTag: e6e6348b-ecd5-5e39-b660-e5ffc700abdb
		displayFolder: 04 Revenue truth

	/// Current open value of explicitly qualified deals. Snapshot by campaign; USD.
	measure 'Open qualified pipeline' = DIVIDE(SUM(mart_qualified_pipeline[open_minor]), 100)
		formatString: \$#,0
		lineageTag: 878468fa-e2e0-5455-92e3-5a48b1dbb4fa
		displayFolder: 04 Revenue truth

	/// Deals with an explicit qualification decision; each deal counts once.
	measure 'Qualified opportunities' = SUM(mart_qualified_pipeline[qualified_deals])
		formatString: #,0
		lineageTag: 13eab3b2-8673-5280-8bcd-f52cd9179150
		displayFolder: 04 Revenue truth

	/// Net cash the warehouse credits to each platform's campaigns.
	measure 'Warehouse cash (paid platforms)' = DIVIDE(SUM(mart_platform_comparison[warehouse_net_cash_cents]), 100)
		formatString: \$#,0
		lineageTag: b65e766c-0d16-5386-830c-80e471777bac
		displayFolder: 04 Revenue truth

	/// Spend on each platform, all time.
	measure 'Platform spend' = DIVIDE(SUM(mart_platform_comparison[spend_cents]), 100)
		formatString: \$#,0
		lineageTag: 9a6a6b4f-cb56-5cb0-8acd-2f6995f80d6e
		displayFolder: 04 Revenue truth

	/// Claimed value the warehouse cannot find in cash.
	measure 'Platform overstatement' = [Platform-reported value] - [Warehouse cash (paid platforms)]
		formatString: \$#,0
		lineageTag: 487b469f-4997-5301-8ccc-99c86e2e1eda
		displayFolder: 04 Revenue truth

	/// What each platform says its spend returned.
	measure 'Reported ROAS' = DIVIDE([Platform-reported value], [Platform spend])
		formatString: 0.00"x"
		lineageTag: ae126f09-4d75-5929-abb0-cca2d8b1d66a
		displayFolder: 04 Revenue truth

	/// What the spend returned in collected, net cash.
	measure 'Warehouse ROAS' = DIVIDE([Warehouse cash (paid platforms)], [Platform spend])
		formatString: 0.00"x"
		lineageTag: 56c314d4-63e1-53d6-8b1d-38768a7e8940
		displayFolder: 04 Revenue truth

	/// Platform claims / warehouse cash: 1.00x would mean the platforms are right.
	measure 'Claim multiple' = DIVIDE([Platform-reported value], [Warehouse cash (paid platforms)])
		formatString: 0.00"x"
		lineageTag: 72daefab-bf2c-57e5-bc8e-ee525b041441
		displayFolder: 04 Revenue truth

	/// People who reached the stage, all time.
	measure 'Funnel people' = SUM(mart_funnel[people])
		formatString: #,0
		lineageTag: a9de6df6-cccf-5274-9aff-d5879033dc31
		displayFolder: 05 Funnel

	/// Paying customers / leads, all time.
	measure 'Lead to paid' =
			DIVIDE(CALCULATE([Funnel people], mart_funnel[stage] = "paid"),
			    CALCULATE([Funnel people], mart_funnel[stage] = "lead"))
		formatString: 0.00%
		lineageTag: 904d8d77-3a12-58b0-a6a9-cba988e6b870
		displayFolder: 05 Funnel

	/// People at this stage / people at the stage before.
	measure 'Stage conversion' =
			VAR vStage = SELECTEDVALUE(mart_funnel[ordinal])
			VAR vHere = [Funnel people]
			VAR vBefore = CALCULATE([Funnel people], REMOVEFILTERS(mart_funnel), mart_funnel[ordinal] = vStage - 1)
			RETURN IF(NOT ISBLANK(vStage) && vStage > 1, DIVIDE(vHere, vBefore))
		formatString: 0.0%
		lineageTag: 17db8721-671c-579d-90cc-359ec78ce8c1
		displayFolder: 05 Funnel

	/// Visitors randomized into the CTA test.
	measure 'Test visitors' = SUM(mart_experiment_variants[visitors])
		formatString: #,0
		lineageTag: 66113b23-6a01-512d-8dc4-64025e9d74c4
		displayFolder: 05 Funnel

	/// Leads / visitors in the CTA test.
	measure 'Test lead rate' = DIVIDE(SUM(mart_experiment_variants[leads]), [Test visitors])
		formatString: 0.00%
		lineageTag: 2b15f12a-8643-5b13-b223-ec481ebef34c
		displayFolder: 05 Funnel

	/// MQLs / leads in the CTA test.
	measure 'Test MQLs per lead' = DIVIDE(SUM(mart_experiment_variants[mqls]), SUM(mart_experiment_variants[leads]))
		formatString: 0.0%
		lineageTag: a0999e98-b5ca-5326-9a8b-5fce2ec1648e
		displayFolder: 05 Funnel

	/// Buyers in the CTA test. Fifteen buyers cannot carry a cash decision.
	measure 'Test customers' = SUM(mart_experiment_variants[customers])
		formatString: #,0
		lineageTag: 50979b28-ede9-515e-88b4-47405245ba20
		displayFolder: 05 Funnel

	/// Net cash / visitors: the metric the test should be decided on.
	measure 'Test cash per visitor' = DIVIDE(SUM(mart_experiment_variants[net_cash_cents]), [Test visitors]) / 100
		formatString: \$#,0.00
		lineageTag: b94e8b8b-ba45-5b92-98b5-29ad7e67b62e
		displayFolder: 05 Funnel

	/// Variant lead rate against control.
	measure 'Variant lead-rate lift' =
			VAR vControl = CALCULATE([Test lead rate], mart_experiment_variants[variant_id] = "cta_a")
			VAR vVariant = CALCULATE([Test lead rate], mart_experiment_variants[variant_id] = "cta_b")
			RETURN DIVIDE(vVariant, vControl) - 1
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: abfa353d-c70f-5797-b674-10d3c94c7eb2
		displayFolder: 05 Funnel

	/// Variant cash per visitor against control.
	measure 'Variant cash-per-visitor lift' =
			VAR vControl = CALCULATE([Test cash per visitor], mart_experiment_variants[variant_id] = "cta_a")
			VAR vVariant = CALCULATE([Test cash per visitor], mart_experiment_variants[variant_id] = "cta_b")
			RETURN DIVIDE(vVariant, vControl) - 1
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 45ccd052-b6c6-50fb-b774-5740bc5eaa76
		displayFolder: 05 Funnel

	/// Views, all time.
	measure 'Content views' = SUM(mart_content_performance[views])
		formatString: #,0
		lineageTag: 015556c3-8292-5704-96a4-76a1b5f286aa
		displayFolder: 06 Content

	/// Leads whose first identified engagement was the item.
	measure 'Content engaged leads' = SUM(mart_content_performance[engaged_leads])
		formatString: #,0
		lineageTag: 76bb9d96-f4cd-535b-968b-73c679c2775b
		displayFolder: 06 Content

	/// Buyers whose first identified engagement was the item.
	measure 'Content customers' = SUM(mart_content_performance[customers])
		formatString: #,0
		lineageTag: 23f97cd6-9ea2-51f7-813a-76502b7d7566
		displayFolder: 06 Content

	/// Net cash from buyers whose first identified engagement was the item.
	measure 'Content-influenced cash' = DIVIDE(SUM(mart_content_performance[influenced_net_cash_cents]), 100)
		formatString: \$#,0
		lineageTag: cc4b7c4d-dd6f-5e94-8c99-6204c9936b76
		displayFolder: 06 Content

	/// Influenced cash per thousand views: views are not buyers.
	measure 'Cash per 1K views' = DIVIDE([Content-influenced cash] * 1000, [Content views])
		formatString: \$#,0.00
		lineageTag: cc052a8e-0c97-5562-991a-403bb766be8e
		displayFolder: 06 Content

	/// Messages sent.
	measure 'Emails sent' = SUM(mart_email_performance[sends])
		formatString: #,0
		lineageTag: 22c7ce84-c674-5d2c-bd2b-52df5dc5347c
		displayFolder: 07 Email

	/// Delivered sends.
	measure 'Emails delivered' = SUM(mart_email_performance[delivered])
		formatString: #,0
		lineageTag: 7f3e1ea8-0e6c-57d5-b866-945d4fa8c8ec
		displayFolder: 07 Email

	/// Opens excluding privacy-proxy machine opens / delivered.
	measure 'Human open rate' = DIVIDE(SUM(mart_email_performance[human_opens]), [Emails delivered])
		formatString: 0.0%
		lineageTag: 14212e10-1937-52d2-9156-9bdd0b81b724
		displayFolder: 07 Email

	/// All opens / delivered, inflated by machine opens; shown only for comparison.
	measure 'Reported open rate' = DIVIDE(SUM(mart_email_performance[opens]), [Emails delivered])
		formatString: 0.0%
		lineageTag: 90a2d976-cdef-586c-93cc-d04f839816fa
		displayFolder: 07 Email

	/// Share of reported opens made by privacy proxies, not people.
	measure 'Machine open share' = DIVIDE(SUM(mart_email_performance[machine_opens]), SUM(mart_email_performance[opens]))
		formatString: 0.0%
		lineageTag: 477a196f-366c-5f48-8efd-3bb39977298d
		displayFolder: 07 Email

	/// Clicks / delivered.
	measure 'Email click rate' = DIVIDE(SUM(mart_email_performance[clicks]), [Emails delivered])
		formatString: 0.00%
		lineageTag: 4e1784a2-9a53-5b54-a19b-a466f3b6d580
		displayFolder: 07 Email

	/// Clicks / human opens.
	measure 'Click-to-open rate' = DIVIDE(SUM(mart_email_performance[clicks]), SUM(mart_email_performance[human_opens]))
		formatString: 0.0%
		lineageTag: 711034eb-7f0c-5c09-aa95-fe42aeea7a79
		displayFolder: 07 Email

	/// Bounces / sends. Above 2% the sending domain is at risk.
	measure 'Bounce rate' = DIVIDE(SUM(mart_email_performance[bounces]), [Emails sent])
		formatString: 0.00%
		lineageTag: f6b3098f-3f6a-57a7-b47e-3aabd3bcf2d7
		displayFolder: 07 Email

	/// Spam complaints / delivered. The mailbox providers' limit is 0.1%.
	measure 'Complaint rate' = DIVIDE(SUM(mart_email_performance[spam_complaints]), [Emails delivered])
		formatString: 0.000%
		lineageTag: bd366f3a-336d-5783-a244-345821609b1a
		displayFolder: 07 Email

	/// Unsubscribes / delivered.
	measure 'Unsubscribe rate' = DIVIDE(SUM(mart_email_performance[unsubscribes]), [Emails delivered])
		formatString: 0.00%
		lineageTag: b1959da5-96be-56c7-8d20-3a2b0331137a
		displayFolder: 07 Email

	/// The 2% bounce threshold, as a reference line.
	measure 'Bounce limit' = 0.02
		formatString: 0.0%
		lineageTag: 1f07e161-a6c9-5f73-a529-9deb703be9d8
		displayFolder: 07 Email

	/// Eligible touches that arrived with UTM parameters.
	measure 'UTM completeness' = DIVIDE(SUM(mart_measurement_health[touches_with_utm]), SUM(mart_measurement_health[eligible_touches]))
		formatString: 0.0%
		lineageTag: 3717e505-8f3a-55dc-8f42-c0444b0940d3
		displayFolder: 08 Data quality

	/// Eligible touches whose campaign is in the registry.
	measure 'Registry coverage' = DIVIDE(SUM(mart_measurement_health[registered_touches]), SUM(mart_measurement_health[eligible_touches]))
		formatString: 0.0%
		lineageTag: 9bb4e911-859c-5448-9b97-3926815419fd
		displayFolder: 08 Data quality

	/// CRM contacts with an owner assigned.
	measure 'Contacts with an owner' = DIVIDE(SUM(mart_measurement_health[owned_contacts]), SUM(mart_measurement_health[contacts]))
		formatString: 0.0%
		lineageTag: 595e709e-ae52-5cf9-b9fd-bb704e46d8c2
		displayFolder: 08 Data quality

	/// Paying contacts whose journey has a lead-creation touch before payment.
	measure 'Valid paid journeys' = DIVIDE(SUM(mart_measurement_health[valid_paid_journeys]), SUM(mart_measurement_health[paid_contact_count]))
		formatString: 0.0%
		lineageTag: b45f80ae-2efa-5f06-b5f5-d1a9fc887d5e
		displayFolder: 08 Data quality

	/// Payments the CRM cannot tie to a contact.
	measure 'Unmatched payments' = SUM(mart_measurement_health[unmatched_payments])
		formatString: #,0
		lineageTag: 0da0c255-8ed4-5850-adfa-c927a4359039
		displayFolder: 08 Data quality

	/// Contact rows sharing an email address.
	measure 'Duplicate contact rows' = SUM(mart_measurement_health[duplicate_contact_rows])
		formatString: #,0
		lineageTag: 1b64daae-9fca-50a4-9b98-3a4ba12a72d6
		displayFolder: 08 Data quality

	/// Short links in use.
	measure 'Short links' = COUNTROWS(mart_link_hygiene)
		formatString: #,0
		lineageTag: 705131e0-6d4a-534c-adf7-efed14d0330f
		displayFolder: 08 Data quality

	/// Short links with missing, unregistered or off-taxonomy UTMs.
	measure 'Links with defects' = COUNTROWS(FILTER(mart_link_hygiene, mart_link_hygiene[missing_utm] || mart_link_hygiene[unregistered_campaign] || mart_link_hygiene[off_taxonomy]))
		formatString: #,0
		lineageTag: 8c32488b-40a3-53cf-a539-88d4dd2abe62
		displayFolder: 08 Data quality

	/// Share of the last 30 days' short-link clicks that land without a valid campaign.
	measure 'Defective link click share' =
			DIVIDE(
			    CALCULATE(SUM(mart_link_hygiene[recent_clicks]),
			        FILTER(mart_link_hygiene, mart_link_hygiene[missing_utm] || mart_link_hygiene[unregistered_campaign] || mart_link_hygiene[off_taxonomy])),
			    SUM(mart_link_hygiene[recent_clicks]))
		formatString: 0.0%
		lineageTag: 3484a348-f803-5dee-9ab1-3f9e7d2f938c
		displayFolder: 08 Data quality

	/// Short-link clicks in the last 30 days.
	measure 'Link recent clicks' = SUM(mart_link_hygiene[recent_clicks])
		formatString: #,0
		lineageTag: b2231197-8b2c-5f05-9b3b-60a7e656f3a6
		displayFolder: 08 Data quality

	/// Contacts in the legacy CRM snapshot.
	measure 'Legacy contacts' = SUM(mart_migration_summary[legacy_contacts])
		formatString: #,0
		lineageTag: 60b6d5d8-1537-5d1f-a319-fdfe1c324a72
		displayFolder: 08 Data quality

	/// Legacy contacts with no match in the new CRM.
	measure 'Missing after migration' = SUM(mart_migration_summary[missing_contacts])
		formatString: #,0
		lineageTag: 29d43f55-d16a-5c6c-bd3b-32a337f7c498
		displayFolder: 08 Data quality

	/// Migrated contacts whose owner survived the move.
	measure 'Owner match' = AVERAGE(mart_migration_summary[owner_match_rate])
		formatString: 0.0%
		lineageTag: 35cebff1-09c9-52cf-9eef-e47f7582b880
		displayFolder: 08 Data quality

	/// Migrated contacts whose original source survived the move.
	measure 'Source match' = AVERAGE(mart_migration_summary[source_match_rate])
		formatString: 0.0%
		lineageTag: 3972bad0-b972-5afc-bde6-0cbddc03cfc4
		displayFolder: 08 Data quality

	/// Migrated contacts whose lifecycle stage survived the move.
	measure 'Stage match' = AVERAGE(mart_migration_summary[stage_match_rate])
		formatString: 0.0%
		lineageTag: ba17eb70-f688-524d-a266-d0f1694ec94d
		displayFolder: 08 Data quality

	/// Community subscriptions due for renewal from the as-of date.
	measure 'Renewals due' = COUNTROWS(mart_renewal_risk)
		formatString: #,0
		lineageTag: 515eab84-d717-5fc7-8679-47db217f2ad4
		displayFolder: 08 Data quality

	/// Renewals due within 14 days (medium), or overdue or with a failed card attempt (high).
	measure 'Renewals at risk' = CALCULATE(COUNTROWS(mart_renewal_risk), mart_renewal_risk[risk_level] IN {"high", "medium"})
		formatString: #,0
		lineageTag: 76a46776-1b3c-5498-aab2-708f510b484f
		displayFolder: 08 Data quality

	/// Card declines on renewals that are still open.
	measure 'Failed renewal attempts' = SUM(mart_renewal_risk[failed_attempts])
		formatString: #,0
		lineageTag: 3e12645b-5e2b-57a0-87e6-b8ce7bf7b6bd
		displayFolder: 08 Data quality

	/// Logged incidents with no end date.
	measure 'Open incidents' = COUNTROWS(FILTER(incident_register, ISBLANK(incident_register[ended_on])))
		formatString: #,0
		lineageTag: 1cc63ba8-4247-5e08-9b49-7df45523093d
		displayFolder: 08 Data quality

	/// Logged incidents.
