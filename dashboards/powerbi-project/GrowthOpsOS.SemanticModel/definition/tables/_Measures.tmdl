		formatString: #,0
		lineageTag: 9c3222c5-7618-5000-bb23-c917bb10e369
		displayFolder: 08 Data quality

	/// The share of records passing a data-quality check.
	measure 'Check rate' = AVERAGE(quality_scorecard[rate])
		formatString: 0.0%
		lineageTag: 28269357-1ba4-556a-8c71-eea7aeebfc32
		displayFolder: 08 Data quality

	/// The level the check is held to.
	measure 'Check target' = AVERAGE(quality_scorecard[target])
		formatString: 0.0%
		lineageTag: 262960c3-2232-5665-a0f7-f92328f195a4
		displayFolder: 08 Data quality

	/// Data-quality checks under their target.
	measure 'Checks below target' = COUNTROWS(FILTER(quality_scorecard, quality_scorecard[rate] < quality_scorecard[target]))
		formatString: #,0
		lineageTag: 54fb9fb0-eb66-5d19-9c86-3216389923f6
		displayFolder: 08 Data quality

	/// Red where a check is under its target.
	measure 'Check colour' = IF([Check rate] < [Check target], "#ef6f61", "#3987e5")
		lineageTag: fb6b69c9-6d1e-5069-a953-96c40be55220
		displayFolder: 13 Colours

	/// Red where a campaign returned less cash than it cost.
	measure 'ROAS colour' = IF([Cash ROAS] < 1, "#ef6f61", "#3987e5")
		lineageTag: a6bf565c-6a6d-5836-904a-16621650802e
		displayFolder: 13 Colours

	/// Red where a campaign qualifies leads at under three-quarters of the paid average.
	measure 'MQL rate colour' =
			VAR vAll = CALCULATE([Paid MQL rate], REMOVEFILTERS(dim_campaign))
			RETURN IF([Paid MQL rate] < 0.75 * vAll, "#ef6f61", "#3987e5")
		lineageTag: f7fd1db5-cec9-54b8-9bf8-a407cd337c5f
		displayFolder: 13 Colours

	/// Net cash over the same number of days immediately before the dates in view.
	measure 'Net cash prior period' =
			VAR vStart = MIN(dim_date[date])
			VAR vEnd = MAX(dim_date[date])
			VAR vDays = INT(vEnd - vStart) + 1
			RETURN CALCULATE([Net cash], REMOVEFILTERS(dim_date),
			    dim_date[date] >= vStart - vDays, dim_date[date] < vStart)
		formatString: \$#,0
		lineageTag: a5fac156-228b-5008-9804-9d6f210bfca5
		displayFolder: 09 Windows

	/// Net cash against the period before.
	measure 'Net cash vs prior' =
			VAR vChange = DIVIDE([Net cash] - [Net cash prior period], ABS([Net cash prior period]))
			RETURN IF(NOT ISBLANK(vChange), ROUND(vChange, 3))
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: 4cdd9764-11aa-5840-85b7-45d1e1877159
		displayFolder: 09 Windows

	/// Tile caption for Net cash.
	measure 'Net cash caption' = IF(ISBLANK([Net cash vs prior]), IF(ISFILTERED(dim_date), "no earlier data to compare with", "all dates in view · pick months to compare"), FORMAT(ROUND([Net cash vs prior], 2), "+0%;-0%;+0%") & " vs prior period")
		lineageTag: 1e880777-a96d-5d98-bc70-ae1ad6f31b38
		displayFolder: 10 Captions

