	measure 'Net collected caption' = "after " & FORMAT([Refunds (all time)] / 1000, "$#,0") & "K of refunds"
		lineageTag: 00164a59-5f7b-5ea6-a4bb-ff70bbac9396
		displayFolder: 10 Captions

	/// Tile caption: the deals behind qualified pipeline and the part still open.
	measure 'Qualified pipeline caption' = FORMAT([Qualified opportunities], "#,0") & " qualified deals; " & FORMAT([Open qualified pipeline] / 1000, "$#,0") & "K still open"
		lineageTag: b3a06ba1-9fc8-5845-b188-420aeb900ccf
		displayFolder: 10 Captions

	/// Tile caption: refund rate.
	measure 'Refund caption' = FORMAT([Refund rate], "0.0%") & " of gross collected"
		lineageTag: 091ac2e7-62fa-5b5c-9d5c-70da943dc77a
		displayFolder: 10 Captions

	/// Tile caption: cash no campaign can claim.
	measure 'Unattributed caption' = FORMAT([Unattributed net cash] / 1000, "$#,0") & "K with no creating touch"
		lineageTag: 8e5b818c-ea1d-5c83-b092-e1bb16aa9c94
		displayFolder: 10 Captions

	/// Tile caption: views against buyers.
	measure 'Content caption' = FORMAT([Content customers], "#,0") & " buyers from " & FORMAT([Content views] / 1000, "#,0") & "K views"
		lineageTag: 1f10a2ad-da64-53e1-9ec3-32dcd29877d5
		displayFolder: 10 Captions

	/// Tile caption: clicks on defective links.
	measure 'Links caption' = FORMAT([Defective link click share], "0%") & " of recent short-link clicks"
		lineageTag: b5664826-3789-5ee3-b7c4-28f7aa8dce65
		displayFolder: 10 Captions

	/// Tile caption: renewal queue.
	measure 'Renewals caption' = FORMAT([Failed renewal attempts], "#,0") & IF([Failed renewal attempts] = 1, " failed card attempt · ", " failed card attempts · ") & FORMAT([Renewals due], "#,0") & " due in total"
		lineageTag: 955ab6dd-5bcb-5e7b-8b7a-cad54e31ab6d
		displayFolder: 10 Captions

