			        & "<text x='0' y='24' font-family='Segoe UI Semibold' font-size='18' fill='#f2f2f4'>Executive summary</text>"
			        & "<text x='0' y='46' font-family='Segoe UI' font-size='11' fill='#7d7d85'>" & vContext & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 93cb60e9-f484-581f-a5c1-cc5b179cad2d
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'KPI SVG Net cash, last 28 days | Net cash, 28-day caption | up Net cash, 28-day change | Net cash · last 28 days @314' =
			VAR vValue = [Net cash, last 28 days]
			VAR vShown = IF(ISBLANK(vValue), "—", IF(ABS(vValue) >= 1000000, FORMAT(vValue / 1000000, "\$#,0.00") & "M", FORMAT(vValue, "\$#,0")))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Net cash, 28-day caption], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 61, LEFT(vCaptionRaw, 59) & "…", vCaptionRaw)
			VAR vTrend = [Net cash, 28-day change]
			VAR vTone = IF(ISBLANK(vTrend) || ROUND(vTrend, 4) = 0, "#7d7d85", IF(vTrend > 0, "#3fb96b", "#ef6f61"))
			VAR vArrow = IF(ISBLANK(vTrend) || ROUND(vTrend, 4) = 0, "", IF(vTrend > 0, "▲ ", "▼ "))
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='314' height='112' viewBox='0 0 314 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='#3987e5'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#a6a6ad'>Net cash · last 28 days</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#f2f2f4'>" & vShown & "</text>"
			        & ""
			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='" & vTone & "'>" & vArrow & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 0b68ef48-8fad-50ab-afbf-597c115eaa94
		dataCategory: ImageUrl
		displayFolder: Report UI

