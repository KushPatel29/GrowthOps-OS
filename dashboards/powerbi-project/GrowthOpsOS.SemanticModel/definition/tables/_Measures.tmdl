	measure 'Migration caption' = FORMAT([Missing after migration], "#,0") & " legacy contacts missing · " & FORMAT([Duplicate contact rows], "#,0") & " duplicates"
		lineageTag: 11d01683-fad3-5cfb-8bf4-a766cfa609ea
