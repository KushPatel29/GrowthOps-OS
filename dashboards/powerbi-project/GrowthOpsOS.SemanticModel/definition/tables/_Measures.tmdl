	measure 'KPI SVG Human open rate | Human open rate caption | up Human open rate vs prior @310' =
			VAR vValue = [Human open rate]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "0.0%"))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Human open rate caption], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 61, LEFT(vCaptionRaw, 59) & "…", vCaptionRaw)
			VAR vTrend = [Human open rate vs prior]
			VAR vTone = IF(ISBLANK(vTrend) || ROUND(vTrend, 4) = 0, "#7d7d85", IF(vTrend > 0, "#3fb96b", "#ef6f61"))
			VAR vArrow = IF(ISBLANK(vTrend) || ROUND(vTrend, 4) = 0, "", IF(vTrend > 0, "▲ ", "▼ "))
			VAR vRail = ROUND(278 * MAX(0, MIN(1, COALESCE(vValue, 0))), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='310' height='112' viewBox='0 0 310 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='#3987e5'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#a6a6ad'>Human open rate</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='#f2f2f4'>" & vShown & "</text>"
			        & "<rect x='16' y='76' width='278' height='6' rx='3' fill='#26262a'/>" & "<rect x='16' y='76' width='" & vRail & "' height='6' rx='3' fill='#3987e5'/>"
			        & "<text x='16' y='100' font-family='Segoe UI' font-size='10' fill='" & vTone & "'>" & vArrow & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 507cd155-a523-503f-a5f4-3e1f77757ca5
		dataCategory: ImageUrl
		displayFolder: Report UI

