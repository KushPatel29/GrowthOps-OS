			VAR vValue = [Paid MQL rate, last 28 days]
			VAR vShown = IF(ISBLANK(vValue), "—", FORMAT(vValue, "0.0%"))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Paid MQL rate, 28-day caption], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 66, LEFT(vCaptionRaw, 64) & "…", vCaptionRaw)
			VAR vTrend = [Paid MQL rate, 28-day change]
