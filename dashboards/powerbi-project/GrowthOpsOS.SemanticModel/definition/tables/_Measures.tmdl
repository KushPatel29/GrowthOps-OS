			VAR vArrow = IF(ISBLANK(vTrend) || ROUND(vTrend, 4) = 0, "", IF(vTrend > 0, "▲ ", "▼ "))
			VAR vRail = ROUND(301 * MAX(0, MIN(1, COALESCE(vValue, 0))), 0)
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='333' height='112' viewBox='0 0 333 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='#3987e5'/>"
