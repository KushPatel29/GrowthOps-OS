	column complaint_rate
		dataType: double
		lineageTag: 1fbd9acb-01c3-5f3f-998b-ca717261b6c2
		summarizeBy: none
		sourceColumn: complaint_rate

	/// Delivered sends.
	measure 'Emails delivered' = SUM('mart_email_performance'[delivered])
		formatString: #,0
		displayFolder: Email
		lineageTag: 5927c7a7-e81a-57e3-b086-5fe179ca99a9

	/// Opens excluding privacy-proxy machine opens / delivered.
	measure 'Human open rate' = DIVIDE(SUM('mart_email_performance'[human_opens]), [Emails delivered])
		formatString: 0.0%
		displayFolder: Email
		lineageTag: 9fda25cd-5110-52bd-bb98-da7f254524f8

	/// All opens / delivered; inflated by machine opens, shown only for comparison.
	measure 'Reported open rate' = DIVIDE(SUM('mart_email_performance'[opens]), [Emails delivered])
		formatString: 0.0%
		displayFolder: Email
		lineageTag: 5493fae1-cff0-561a-8f2a-773dee20a6da

	/// Clicks / delivered (email CTR).
	measure 'Email click rate' = DIVIDE(SUM('mart_email_performance'[clicks]), [Emails delivered])
		formatString: 0.00%
		displayFolder: Email
		lineageTag: a660f156-0444-5bc3-8103-cca17982077e

	/// Clicks / human opens.
	measure 'Click-to-open rate' = DIVIDE(SUM('mart_email_performance'[clicks]), SUM('mart_email_performance'[human_opens]))
		formatString: 0.0%
		displayFolder: Email
		lineageTag: ad881d07-c8ab-5270-8e1e-d1e52011d44b

	/// Bounces / sends; above 2% flags the sending domain.
	measure 'Bounce rate' = DIVIDE(SUM('mart_email_performance'[bounces]), SUM('mart_email_performance'[sends]))
		formatString: 0.00%
		displayFolder: Email
		lineageTag: d323a570-8812-519d-930a-0ea7f41193a0

	/// Spam complaints / delivered; limit 0.1%.
	measure 'Complaint rate' = DIVIDE(SUM('mart_email_performance'[spam_complaints]), [Emails delivered])
		formatString: 0.000%
		displayFolder: Email
		lineageTag: a0d16d8c-2ba5-5ece-b2b2-a7a700f0d0ab

