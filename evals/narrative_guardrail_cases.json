{
  "description": "Labelled cases for the executive-narrative guardrail. Each narrative must be accepted or rejected exactly as labelled against the fixed findings below.",
  "findings": [
    {
      "id": "ops_dead_letter",
      "category": "automation",
      "finding": "12 paying customers have no community access.",
      "evidence": "12 payment events ($61,600) exhausted 5 attempts after the access provider returned errors; the first failed at 2026-09-18 10:12 UTC.",
      "why": "Top error: community_access: HTTP 503 Service Unavailable.",
      "investigation": "Replay the dead-lettered events now that the provider is healthy, then confirm access."
    },
    {
      "id": "mql_rate:2026-08-13",
      "category": "growth",
      "finding": "Lead-to-MQL rate fell from 29.8% to 20.4%.",
      "evidence": "Lead-to-MQL rate -9.4 pp (z 5.4); window 2026-08-07 to 2026-08-21.",
      "why": "meta_broad_v17 (new in this period) explains 92% (-8.6 pp).",
      "investigation": "Review meta_broad_v17's audience before adding budget: its cost per MQL is $286 against $169 for the rest of paid media."
    },
    {
      "id": "utm_completeness:2026-09-06",
      "category": "tracking",
      "finding": "UTM completeness fell from 97.6% to 90.2%.",
      "evidence": "UTM completeness -7.5 pp (z 17.6); window 2026-08-31 to 2026-09-17.",
      "why": "/webinar explains 101% (-7.6 pp).",
      "investigation": "Check the latest release of /webinar. $42,300 of net cash cannot be credited to any campaign."
    },
    {
      "id": "renewal_risk",
      "category": "retention",
      "finding": "3 community renewals are overdue or failed.",
      "evidence": "3 of 144 active subscriptions; 2 more renew in the next 14 days.",
      "why": "Card failures.",
      "investigation": "Ask customers to update payment details."
    }
  ],
